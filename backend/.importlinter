# =============================================================================
# import-linter — 백엔드 아키텍처 하네스 (redoceanmap과 동일한 계약 5종)
# =============================================================================
#   (1) 앱 '내부'  — 헥사고날/클린: adapter → app → domain (역방향 금지)
#   (2) 앱 '사이'  — 스타 토폴로지: hub 중심, 스포크끼리 직접 참조 금지
#
# 실행:  cd backend && PYTHONPATH=apps .venv/bin/lint-imports --config .importlinter
# =============================================================================

[importlinter]
root_packages =
    hub
    auth
    save
    masterdata
    codex
include_external_packages = True

[importlinter:contract:clean-architecture]
name = 클린 아키텍처 계층 (adapter > app > domain) — 허브·전 스포크 공통
type = layers
layers =
    (adapter)
    app
    (domain)
containers =
    hub
    auth
    save
    masterdata
    codex

[importlinter:contract:spoke-independence]
name = 스포크 상호 독립 (스포크 ↔ 스포크 직접 참조 금지)
type = independence
modules =
    auth
    save
    masterdata
    codex

[importlinter:contract:framework-isolation]
name = 프레임워크 격리 (app·domain → fastapi/sqlalchemy import 금지)
type = forbidden
source_modules =
    hub.app
    auth.app
    auth.domain
    save.app
    save.domain
    masterdata.app
    masterdata.domain
    codex.app
    codex.domain
forbidden_modules =
    fastapi
    sqlalchemy
    jwt

[importlinter:contract:domain-purity]
name = 도메인 순수성 (domain → pydantic import 금지)
type = forbidden
source_modules =
    auth.domain
    save.domain
    masterdata.domain
    codex.domain
forbidden_modules =
    pydantic

[importlinter:contract:hub-isolation]
name = 허브 격리 (hub → 스포크 import 금지)
type = forbidden
source_modules =
    hub
forbidden_modules =
    auth
    save
    masterdata
    codex
    codex
