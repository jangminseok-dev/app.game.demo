# 복사해서 .env로 쓴다. .env는 git 제외. 키를 추가하면 여기에도 등록한다.

# --- DB (docker-compose.yaml) ---
POSTGRES_DB=idle_fantasy
POSTGRES_USER=idle
POSTGRES_PASSWORD=

# --- backend (backend/core/config.py) ---
DATABASE_URL=postgresql://idle:${POSTGRES_PASSWORD}@127.0.0.1:5440/idle_fantasy
# JWT 서명 비밀. 32바이트 이상 난수: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=86400
